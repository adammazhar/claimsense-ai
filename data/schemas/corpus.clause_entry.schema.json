{
  "additionalProperties": false,
  "description": "One clause of a policy form.",
  "properties": {
    "clause_id": {
      "pattern": "^CLS-[A-Z]{2,3}-\\d{3}$",
      "title": "Clause Id",
      "type": "string"
    },
    "form_number": {
      "pattern": "^SYN-",
      "title": "Form Number",
      "type": "string"
    },
    "form_edition": {
      "format": "date",
      "title": "Form Edition",
      "type": "string"
    },
    "section": {
      "description": "For example, 'Part D: Coverage for damage to your auto'.",
      "minLength": 1,
      "title": "Section",
      "type": "string"
    },
    "heading": {
      "minLength": 1,
      "title": "Heading",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "tags": {
      "description": "Coverage or topic tags used to filter retrieval.",
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "supersedes": {
      "anyOf": [
        {
          "pattern": "^CLS-[A-Z]{2,3}-\\d{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    }
  },
  "required": [
    "clause_id",
    "form_number",
    "form_edition",
    "section",
    "heading",
    "text"
  ],
  "title": "ClauseEntry",
  "type": "object"
}
